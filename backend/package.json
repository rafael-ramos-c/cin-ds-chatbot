{
  "name": "secgrad",
  "version": "1.0.0",
  "description": "Assistente de orientação acadêmica baseado em documentos do CIn",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nest build && tsc-alias -p tsconfig.build.json && node --watch dist/main.js",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "lint": "biome check src/ test/",
    "lint:ci": "biome ci src/ test/",
    "format": "biome format --write src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run test/migration-http.spec.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "migration:generate": "prisma migrate dev --schema prisma/schema.prisma",
    "migration:run": "prisma migrate deploy --schema prisma/schema.prisma",
    "prepare": "husky",
    "lint:fix": "biome check --write src/ test/",
    "test:migration": "vitest run test/migration-http.spec.ts src/common/auth/identity/keycloak.identity-source.spec.ts",
    "start:dev": "nest build && tsc-alias -p tsconfig.build.json && node --watch dist/main.js",
    "test:live": "vitest run --config vitest.e2e.config.ts test/migration-live.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^5.19.1",
    "class-transformer": "^0.5.1",
    "jose": "^6.2.3",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.24",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "husky": "^9.1.7",
    "prisma": "^5.19.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild": true,
    "@nestjs/core": false,
    "@scarf/scarf": false,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  },
  "engines": {
    "node": "24.x"
  }
}
