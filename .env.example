# Ambiente LOCAL. Trocar credenciais e configurar TLS antes de publicar.
POSTGRES_USER=secgrad
POSTGRES_PASSWORD=secgrad-local
POSTGRES_DB=secgrad
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
KEYCLOAK_REALM=Local
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:3000/secgrad/api/v1
VITE_KEYCLOAK_JSON={"realm":"Local","auth-server-url":"http://localhost:8080/auth/","resource":"secgrad-front","public-client":true}
# Modos: disabled, mock (simulação identificada), openai (API real).
SECGRAD_GENERATION_MODE=mock
SECGRAD_OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
FALLBACK_DISTANCE_THRESHOLD=0.8
